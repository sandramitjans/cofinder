# Copiar como .env (junto a transcribir.py) y rellenar. NO subir el .env a GitHub.
# Supabase → Project Settings → API: «Project URL» y la clave «service_role» (secreta: solo en el servidor)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de Whisper: tiny, base, small (recomendado sin tarjeta gráfica), medium o turbo (más preciso, más lento sin GPU)
WHISPER_MODEL=small
# Idioma de los audios: vacío = lo detecta solo; o es / fr / en
WHISPER_LANGUAGE=
INTERVALO_SEGUNDOS=10
